/**
 * Rofi Application Launcher Theme
 * Minimal Dark Palette (#0C0D10, #17191F, #202126, #AAAAAA)
 * Font: JetBrainsMono Nerd Font
 */

configuration {
    modi: "drun,run,window";
    font: "JetBrainsMono Nerd Font 10.5";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "󰄲";
    display-run: "󰌑";
    display-window: "󰖲";
    drun-display-format: "{name}";
    terminal: "kitty";
    case-sensitive: false;
    cycle: true;
}

@theme "/dev/null"

* {
    bg:          #0C0D10;
    bg-alt:      #17191F;
    surface:     #202126;
    fg:          #D5D5D5;
    fg-dim:      #888888;
    accent:      #AAAAAA;
    border-col:  #333333;

    background-color: transparent;
    text-color:       @fg;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    width:            580px;
    height:           500px;
    background-color: @bg;
    border:           1px solid;
    border-color:     @border-col;
    border-radius:    10px;
    padding:          18px;
    location:         center;
    anchor:           center;
}

mainbox {
    children: [ inputbar, listview, footer ];
    spacing:  12px;
}

inputbar {
    background-color: @bg-alt;
    border:           1px solid;
    border-color:     @surface;
    border-radius:    8px;
    padding:          10px 14px;
    children:         [ prompt, entry ];
    spacing:          12px;
}

prompt {
    text-color: @accent;
    font:       "JetBrainsMono Nerd Font Bold 12";
}

entry {
    text-color:        @fg;
    font:              "JetBrainsMono Nerd Font 10.5";
    placeholder:       "Search applications...";
    placeholder-color: @fg-dim;
}

listview {
    lines:        8;
    columns:      1;
    spacing:      5px;
    scrollbar:    false;
    dynamic:      true;
}

element {
    padding:       8px 12px;
    border-radius: 6px;
    children:      [ element-icon, element-text ];
    spacing:       12px;
}

element selected {
    background-color: @surface;
    text-color:       #FFFFFF;
    border:           1px solid;
    border-color:     @accent;
}

element-icon {
    size:            26px;
    vertical-align:  0.5;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
}

footer {
    expand:   false;
    children: [ footer-text ];
}

footer-text {
    font:             "JetBrainsMono Nerd Font 9";
    text-color:       @fg-dim;
    horizontal-align: 0.5;
}
