/**
 * Rofi Power & Session Menu Theme
 * Minimal Dark Palette (#0C0D10, #17191F, #202126, #AAAAAA)
 * Font: JetBrainsMono Nerd Font
 */

configuration {
    modi: "dmenu";
    font: "JetBrainsMono Nerd Font 11";
    show-icons: false;
    case-sensitive: false;
    cycle: true;
}

@theme "/dev/null"

* {
    bg:          #0C0D10;
    bg-alt:      #17191F;
    surface:     #202126;
    fg:          #D5D5D5;
    fg-dim:      #888888;
    accent:      #AAAAAA;
    border-col:  #333333;

    background-color: transparent;
    text-color:       @fg;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    width:            420px;
    height:           380px;
    background-color: @bg;
    border:           1px solid;
    border-color:     @border-col;
    border-radius:    10px;
    padding:          18px;
    location:         center;
    anchor:           center;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  12px;
}

inputbar {
    background-color: @bg-alt;
    border:           1px solid;
    border-color:     @surface;
    border-radius:    8px;
    padding:          10px 14px;
    children:         [ prompt ];
}

prompt {
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 12";
    horizontal-align: 0.5;
}

listview {
    lines:        6;
    columns:      1;
    spacing:      6px;
    scrollbar:    false;
    dynamic:      true;
}

element {
    padding:       10px 14px;
    border-radius: 6px;
    children:      [ element-text ];
}

element selected {
    background-color: @surface;
    text-color:       #FFFFFF;
    border:           1px solid;
    border-color:     @accent;
}

element-text {
    text-color:       inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
    markup:           true;
}
