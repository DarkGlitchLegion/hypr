/**
 * Rofi Minimal Dark Theme
 * Font: JetBrainsMono Nerd Font
 */

configuration {
    modi: "drun,run,window";
    font: "JetBrainsMono Nerd Font 10";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "󰄲";
    display-run: "󰌑";
    display-window: "󰖲";
    drun-display-format: "{name}";
    terminal: "kitty";
}

@theme "/dev/null"

* {
    bg: #0C0D10;
    bg-alt: #17191F;
    surface: #202126;
    fg: #D5D5D5;
    fg-dim: #888888;
    accent: #AAAAAA;
    border-col: #333333;

    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 480px;
    background-color: @bg;
    border: 1px solid;
    border-color: @border-col;
    border-radius: 8px;
    padding: 16px;
    location: center;
    anchor: center;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    background-color: @bg-alt;
    border: 1px solid;
    border-color: @surface;
    border-radius: 6px;
    padding: 8px 12px;
    children: [ prompt, entry ];
    spacing: 10px;
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 11";
}

entry {
    text-color: @fg;
    placeholder: "Search applications...";
    placeholder-color: @fg-dim;
}

listview {
    lines: 7;
    columns: 1;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 8px 10px;
    border-radius: 6px;
    children: [ element-icon, element-text ];
    spacing: 10px;
}

element selected {
    background-color: @surface;
    text-color: #FFFFFF;
    border: 1px solid;
    border-color: @accent;
}

element-icon {
    size: 20px;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
