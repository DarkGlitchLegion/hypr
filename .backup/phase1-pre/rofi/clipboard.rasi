/**
 * Rofi Clipboard Manager Theme
 * Minimal Dark Palette (#0C0D10, #17191F, #202126, #AAAAAA)
 * Font: JetBrainsMono Nerd Font
 */

configuration {
    font:                "JetBrainsMono Nerd Font 10";
    show-icons:          false;
    terminal:            "kitty";
    case-sensitive:      false;
    cycle:               true;
}

@theme "/dev/null"

* {
    bg:          #0C0D10;
    bg-alt:      #17191F;
    surface:     #202126;
    fg:          #D5D5D5;
    fg-dim:      #888888;
    accent:      #AAAAAA;
    border-col:  #333333;

    background-color: transparent;
    text-color:       @fg;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    width:            640px;
    height:           480px;
    background-color: @bg;
    border:           1px solid;
    border-color:     @border-col;
    border-radius:    10px;
    padding:          18px;
    location:         center;
    anchor:           center;
}

mainbox {
    children: [ inputbar, listview, footer ];
    spacing:  12px;
}

inputbar {
    background-color: @bg-alt;
    border:           1px solid;
    border-color:     @surface;
    border-radius:    8px;
    padding:          10px 14px;
    children:         [ prompt, entry ];
    spacing:          12px;
}

prompt {
    text-color: @accent;
    font:       "JetBrainsMono Nerd Font Bold 11";
}

entry {
    text-color:        @fg;
    font:              "JetBrainsMono Nerd Font 10";
    placeholder:       "Search clipboard history (or type 'CLEAR' to wipe)...";
    placeholder-color: @fg-dim;
}

listview {
    lines:        8;
    columns:      1;
    spacing:      5px;
    scrollbar:    false;
    dynamic:      true;
}

element {
    padding:       9px 12px;
    border-radius: 6px;
    children:      [ element-text ];
    spacing:       10px;
}

element selected {
    background-color: @surface;
    text-color:       #FFFFFF;
    border:           1px solid;
    border-color:     @accent;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
}

footer {
    expand:   false;
    children: [ footer-text ];
}

footer-text {
    font:             "JetBrainsMono Nerd Font 9";
    text-color:       @fg-dim;
    horizontal-align: 0.5;
}
