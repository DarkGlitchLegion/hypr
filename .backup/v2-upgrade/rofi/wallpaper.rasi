/**
 * Rofi Custom Wallpaper Selector Theme
 * Minimal Dark Palette (#0C0D10, #17191F, #202126, #AAAAAA)
 * Grid / Thumbnail Layout with Keyboard Navigation
 */

configuration {
    modi: "dmenu";
    font: "JetBrainsMono Nerd Font 10.5";
    show-icons: true;
    case-sensitive: false;
    cycle: true;
}

@theme "/dev/null"

* {
    bg:          #0C0D10;
    bg-alt:      #17191F;
    surface:     #202126;
    fg:          #D5D5D5;
    fg-dim:      #888888;
    accent:      #AAAAAA;
    border-col:  #333333;

    background-color: transparent;
    text-color:       @fg;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    width:            780px;
    height:           560px;
    background-color: @bg;
    border:           1px solid;
    border-color:     @border-col;
    border-radius:    10px;
    padding:          20px;
    location:         center;
    anchor:           center;
}

mainbox {
    children: [ inputbar, listview, footer ];
    spacing:  14px;
}

inputbar {
    background-color: @bg-alt;
    border:           1px solid;
    border-color:     @surface;
    border-radius:    8px;
    padding:          10px 14px;
    children:         [ prompt, entry ];
    spacing:          12px;
}

prompt {
    text-color: @accent;
    font:       "JetBrainsMono Nerd Font Bold 11.5";
}

entry {
    text-color:        @fg;
    font:              "JetBrainsMono Nerd Font 10.5";
    placeholder:       "Search wallpaper...";
    placeholder-color: @fg-dim;
}

listview {
    lines:        7;
    columns:      1;
    spacing:      8px;
    scrollbar:    true;
    dynamic:      true;
}

scrollbar {
    width:        4px;
    handle-width: 4px;
    handle-color: @surface;
    border-radius: 4px;
    margin:       0 0 0 6px;
}

element {
    padding:       10px 14px;
    border-radius: 8px;
    children:      [ element-icon, element-text ];
    spacing:       16px;
}

element selected {
    background-color: @surface;
    text-color:       #FFFFFF;
    border:           1px solid;
    border-color:     @accent;
}

element-icon {
    size:            64px;
    vertical-align:  0.5;
    border-radius:   4px;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
    markup:         true;
}

footer {
    expand:   false;
    children: [ footer-text ];
}

footer-text {
    font:             "JetBrainsMono Nerd Font 9";
    text-color:       @fg-dim;
    horizontal-align: 0.5;
}
