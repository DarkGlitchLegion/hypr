{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 6,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "network",
        "pulseaudio",
        "pulseaudio#microphone",
        "bluetooth",
        "battery",
        "power-profiles-daemon",
        "custom/dnd",
        "clock",
        "custom/power"
    ],
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "on-click": "activate"
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 45,
        "separate-outputs": true,
        "rewrite": {
            "": "Arch Linux — Hyprland"
        }
    },
    "cpu": {
        "format": " {usage}%",
        "interval": 2,
        "tooltip": true,
        "tooltip-format": "CPU Usage: {usage}%\nLoad: {load}",
        "on-click": "kitty --class btop --title btop --config /home/darkglitch/.config/hypr/kitty/kitty.conf -e btop"
    },
    "memory": {
        "format": " {percentage}%",
        "interval": 2,
        "tooltip": true,
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)\nSwap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB",
        "on-click": "kitty --class btop --title btop --config /home/darkglitch/.config/hypr/kitty/kitty.conf -e btop"
    },
    "network": {
        "interval": 2,
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 Wired",
        "format-linked": "󰈀 Link",
        "format-disconnected": "󰤭 Offline",
        "tooltip-format-wifi": "󰤨 {essid} ({signalStrength}%)\nIP: {ipaddr}/{cidr}\n󰇚 {bandwidthDownBytes}  󰕒 {bandwidthUpBytes}",
        "tooltip-format-ethernet": "󰈀 {ifname}\nIP: {ipaddr}/{cidr}\n󰇚 {bandwidthDownBytes}  󰕒 {bandwidthUpBytes}",
        "tooltip-format-disconnected": "󰤭 Disconnected",
        "on-click": "/home/darkglitch/.config/hypr/scripts/wifi-menu.sh"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋋",
            "headset": "󰋋",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 2,
        "on-click": "/home/darkglitch/.config/hypr/scripts/audio-menu.sh",
        "on-click-middle": "pavucontrol",
        "on-click-right": "/home/darkglitch/.config/hypr/scripts/volume.sh mute"
    },
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭 Muted",
        "scroll-step": 2,
        "on-click": "/home/darkglitch/.config/hypr/scripts/audio-menu.sh inputs",
        "on-click-middle": "pavucontrol",
        "on-click-right": "/home/darkglitch/.config/hypr/scripts/volume.sh mic"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱 {device_alias}",
        "format-connected-battery": "󰂱 {device_alias} ({device_battery_percentage}%)",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "/home/darkglitch/.config/hypr/scripts/bluetooth-menu.sh"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip": true,
        "tooltip-format": "Battery: {capacity}%\nStatus: {status}\nTime remaining: {time}\nPower draw: {power}W\nCycles: {cycles}",
        "tooltip-format-charging": "Battery: {capacity}% (Charging)\nTime to full: {time}\nPower draw: {power}W\nCycles: {cycles}",
        "on-click": "/home/darkglitch/.config/hypr/scripts/power-profile-menu.sh",
        "on-click-right": "/home/darkglitch/.config/hypr/scripts/power-profile-menu.sh cycle"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power Profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "󰾆",
            "performance": "󰓅",
            "balanced": "󰾆",
            "power-saver": "󰌪"
        }
    },
    "custom/dnd": {
        "exec": "/home/darkglitch/.config/hypr/scripts/dnd-status.sh",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "format": "{}",
        "on-click": "/home/darkglitch/.config/hypr/scripts/notification-toggle.sh",
        "tooltip": true
    },
    "clock": {
        "interval": 1,
        "format": "󰸗 {:%a %b %d  󰥔 %H:%M}",
        "format-alt": "󰥔 {:%H:%M:%S}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#aaaaaa'><b>{}</b></span>",
                "days": "<span color='#d5d5d5'>{}</span>",
                "weeks": "<span color='#888888'><b>W{}</b></span>",
                "weekdays": "<span color='#888888'><b>{}</b></span>",
                "today": "<span color='#0c0d10' background='#aaaaaa'><b>{}</b></span>"
            }
        }
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": true,
        "tooltip-format": "Power Menu (Super + Escape)",
        "on-click": "/home/darkglitch/.config/hypr/scripts/power-menu.sh"
    }
}
